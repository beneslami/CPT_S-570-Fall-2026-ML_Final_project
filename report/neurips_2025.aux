\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Fee drag and calibration-error geometry.} \textbf  {(a)} Round-trip fee drag $\mathrm  {Fee}_R\approx 2c/\mathrm  {sl\_pct}$ across all three asset-class fee tiers; one rule ($\mathrm  {Fee}_R\le 0.05R$) automatically adapts minimum stop width to Forex ($0.08\%$), US equity indices ($0.20\%$), and crypto ($0.40\%$). \textbf  {(b)} A $+2\text  { pp}$ probability overestimate inflates raw $\mathrm  {EV}_R$ linearly by $(\mathrm  {RR}+1)\epsilon $, biasing selection toward noisy $4{:}1$ targets, whereas Per-Trade Sharpe $S = \mathrm  {EV}_R/ \mathrm  {Std}_R$ removes the $(\mathrm  {RR}+1)$ multiplier.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:ev_theory}{{1}{5}{\textbf {Fee drag and calibration-error geometry.} \textbf {(a)} Round-trip fee drag $\FeeR \approx 2c/\mathrm {sl\_pct}$ across all three asset-class fee tiers; one rule ($\FeeR \le 0.05R$) automatically adapts minimum stop width to Forex ($0.08\%$), US equity indices ($0.20\%$), and crypto ($0.40\%$). \textbf {(b)} A $+2\text { pp}$ probability overestimate inflates raw $\EVR $ linearly by $(\RR +1)\epsilon $, biasing selection toward noisy $4{:}1$ targets, whereas Per-Trade Sharpe $S = \EVR / \StdR $ removes the $(\RR +1)$ multiplier}{figure.1}{}}
